# ---------------------------------------------------------------------------
# apps/api environment
# Copy to .env and fill in. The app validates this file at boot (src/config/env.ts)
# and refuses to start rather than serving requests it cannot fulfil.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Pooled connection used at runtime. On a serverless host (Vercel) this MUST be
# a pooler URL (PgBouncer / Prisma Accelerate / Supabase pooler, port 6543) or
# concurrent lambdas will exhaust Postgres connections.
DATABASE_URL=postgresql://user:password@localhost:5432/pms?schema=public
# Direct (unpooled) connection. Prisma Migrate needs this; runtime does not.
DIRECT_URL=postgresql://user:password@localhost:5432/pms?schema=public

# --- API gate --------------------------------------------------------------
# Shared secret every non-public route requires in the `clientId` header.
# Must equal apps/web's NEXT_PUBLIC_API_CLIENT_ID. Generate: openssl rand -hex 24
CLIENT_ID=change-me

# Set to `local` to waive the clientId gate for scripts and Swagger.
# Refused at boot when NODE_ENV=production.
SITE_MODE=

# --- Auth ------------------------------------------------------------------
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ISSUER=pms-api
JWT_AUDIENCE=pms-web
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_VERIFY_EXPIRES=1d
JWT_PASSWORD_RESET_EXPIRES=1h

# --- HTTP ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API. No trailing slash.
# `*` is permitted only outside production.
CORS_ORIGINS=http://localhost:3000

# Proxy hops in front of the app. 1 for Vercel and most PaaS; 0 when the app is
# exposed directly. Wrong value = every caller shares one rate-limit bucket.
TRUST_PROXY_HOPS=1

JSON_BODY_LIMIT=1mb

# Serve Swagger UI at /api. Defaults to off in production.
ENABLE_API_DOCS=true

# --- Web app --------------------------------------------------------------
# Public URL of the frontend, used to build links inside emails.
# Required when NODE_ENV=production.
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=PMS

# --- Email (Brevo) --------------------------------------------------------
# Either an API v3 key (Brevo -> SMTP & API -> API Keys, starts with xkeysib-) which sends
# over HTTPS, or an SMTP login + key (SMTP tab, key starts with xsmtpsib-). The mailer picks
# the transport from the key prefix. If the Brevo account restricts API access by IP, add the
# server's IP under Brevo -> Security -> Authorised IPs or turn that restriction off.
BREVO_API_KEY=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
# Must be a sender verified in Brevo, or delivery is silently dropped.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PMS

# --- Cart charges ---------------------------------------------------------
# Added on top of the cart subtotal and pre-filled at checkout. Tax is a percent
# of the subtotal; the fees are flat amounts in the store currency. Shipping is
# waived once the subtotal reaches CART_FREE_SHIPPING_ABOVE (empty = never).
CART_TAX_RATE=0
CART_PLATFORM_FEE=0
CART_SHIPPING_CHARGE=0
CART_FREE_SHIPPING_ABOVE=

# --- Payments (Razorpay) --------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS (Twilio, optional) ----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
