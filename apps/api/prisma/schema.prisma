generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                       Int               @id @default(autoincrement())
  userId                   String            @unique
  name                     String
  phone                    String?
  email                    String            @unique
  password                 String
  role                     Role              @default(USER)
  isActive                 Boolean           @default(false)
  isRegisteredByShop       Boolean           @default(false)
  isEmailVerified          Boolean           @default(false)
  emailVerificationToken   String?           @unique
  emailVerificationExpires DateTime?
  isPhoneVerified          Boolean           @default(false)
  loginAttempts            Int               @default(0)
  lastLoginAt              DateTime?
  lastLoginIP              String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime?         @updatedAt
  status                   Status            @default(Published)
  token                    String?
  tokenUpdated             Boolean           @default(false)
  refreshToken             String?
  storeCode                String?
  carts                    Cart[]
  sessions                 UserSession[]
  orders                   order[]
  productsCreated          product[]         @relation("CreatedBy")
  productsUpdated          product[]         @relation("UpdatedBy")
  staff                    staff?
  recordedAttendances      staffAttendance[] @relation("staff_attendance_recorder")
  staffAttendances         staffAttendance[] @relation("staff_member")
  processedSalaries        staffSalary[]     @relation("salary_processor")
  staffSalaries            staffSalary[]     @relation("salary_staff")
  store                    store?            @relation(fields: [storeCode], references: [code])
  stockHistories           stockHistory[]
  purchases                purchase[]
  productVariants          ProductVariant[]
  UserProfile              UserProfile?
  Review                   Review[]
  ReviewReply              ReviewReply[]
  Wishlist                 Wishlist[]

  @@index([userId])
  @@index([email])
  @@index([phone])
  @@index([role])
}

model UserProfile {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique // Enforces a strict 1-to-1 relationship
  name            String
  userName        String    @unique
  dateOfBirth     DateTime?
  address         String?
  city            String?
  state           String?
  country         String?
  pincode         String?
  bio             String? // Text blobs are better stored here
  profileImageUrl String?
  metadata        Json? // Heavy JSON belongs in the less-frequently-queried table
  user            users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([city, state]) // Helpful for geo-queries
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String
  accessTokenHash  String    @unique @db.VarChar(255)
  refreshTokenHash String?   @unique @db.VarChar(255)
  ipAddress        String?   @db.VarChar(64)
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user users @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

model Cart {
  id           Int        @id @default(autoincrement())
  storeId      Int
  userId       String?
  sessionToken String?    @unique @db.VarChar(255)
  status       CartStatus @default(ACTIVE)
  currency     String     @default("IND") @db.Char(3)
  expiresAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  store store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  users?     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  items CartItem[]

  @@index([storeId, status, updatedAt])
  @@index([userId, status])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  variantId Int
  quantity  Int
  unitPrice Decimal? @db.Decimal(12, 2)
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model store {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  code             String            @unique
  address          String?
  phone            String?
  email            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  status           Status            @default(Published)
  attributes       attribute[]
  brandNames       brandName[]
  categories       category[]
  orders           order[]
  orderItems       orderItem[]
  payments         payment[]
  Product          product[]
  staffDetails     staff[]
  staffAttendances staffAttendance[]
  staffSalary      staffSalary[]
  staff            users[]
  stockHistories   stockHistory[]
  purchases        purchase[]
  productVariants  ProductVariant[]
  suppliers        supplier[]
  Cart             Cart[]
  Wishlist         Wishlist[]
  masterAttributes MasterAttribute[]
  masterEntries    MasterEntry[]
}

model category {
  id           Int         @id @default(autoincrement())
  name         String
  description  String?
  parentId     Int?
  storeCode    String
  status       Status      @default(Published)
  displayOrder Int?        @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime?
  parent       category?   @relation("CategoryToParent", fields: [parentId], references: [id])
  children     category[]  @relation("CategoryToParent")
  store        store       @relation(fields: [storeCode], references: [code])
  products     product[]
  brandNames   brandName[] @relation("brandNameTocategory")

  @@unique([name, storeCode])
  @@index([storeCode])
}

model product {
  id                Int              @id @default(autoincrement())
  name              String
  parentId          Int?
  categoryId        Int
  brandNameId       Int?
  attributeId       Int?
  slug              String           @unique
  description       String?
  shortDescription  String?
  seoTitle          String?          @db.VarChar(255)
  seoDescription    String?
  isFeatured        Boolean          @default(false)
  lowStockThreshold Int?             @default(5)
  images            String[]         @default([])
  storeCode         String
  status            Status           @default(Published)
  displayOrder      Int?             @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime?        @updatedAt
  deletedAt         DateTime?
  createdById       String
  updatedById       String?
  orderItems        orderItem[]
  attribute         attribute?       @relation(fields: [attributeId], references: [id])
  brandName         brandName?       @relation(fields: [brandNameId], references: [id])
  category          category         @relation(fields: [categoryId], references: [id])
  createdBy         users            @relation("CreatedBy", fields: [createdById], references: [userId])
  parent            product?         @relation("ProductHierarchy", fields: [parentId], references: [id])
  children          product[]        @relation("ProductHierarchy")
  store             store            @relation(fields: [storeCode], references: [code])
  updatedBy         users?           @relation("UpdatedBy", fields: [updatedById], references: [userId])
  stockHistories    stockHistory[]
  purchaseItems     purchaseItem[]
  variants          ProductVariant[]
  Review            Review[]
  Wishlist          Wishlist[]
}

/// Append-only priced variant history for a product. `product.price`/`product.cost`
/// are kept as a denormalized "current" cache; this table is the source of
/// truth for what a product's price was on any given date. The effective
/// variant on a date D is the row with the greatest `effectiveFrom <= D`.
model ProductVariant {
  id            Int            @id @default(autoincrement())
  productId     Int
  sku           String         @unique // e.g., "TSHIRT-001-RED-L"
  attributes    Json // ✅ { "size": "L", "color": "Red", "material": "Cotton" }
  storeCode     String
  sellingPrice  Decimal
  costPrice     Decimal?
  effectiveFrom DateTime       @default(now())
  stockQuantity Int            @default(0)
  isActive      Boolean        @default(false)
  reason        String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime?      @updatedAt
  deletedAt     DateTime?
  metadata      Json? // Heavy JSON belongs i
  product       product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         store          @relation(fields: [storeCode], references: [code])
  createdBy     users          @relation(fields: [createdById], references: [userId])
  cartItems      CartItem[]
  priceHistory   PriceHistory[]
  /// Movements booked against this variant. `stockQuantity` caches their sum.
  stockHistories stockHistory[]

  @@index([productId])
  @@index([storeCode])
  @@index([productId, effectiveFrom])
  @@index([productId, isActive])
}

model PriceHistory {
  id            Int      @id @default(autoincrement())
  variantId     Int
  sellingPrice  Decimal  @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2)
  effectiveFrom DateTime @default(now())
  reason        String? // e.g., "Seasonal sale", "Cost increase"

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
}

model stockHistory {
  id        Int      @id @default(autoincrement())
  productId Int
  /// Which variant the movement applies to. Nullable because rows written before stock
  /// became variant-level (and the product/order/purchase flows that are still
  /// product-keyed) carry no variant. New manual stock movements always set it.
  variantId Int?
  storeCode String
  userId    String
  quantity  Int
  reason    String?
  createdAt DateTime @default(now())

  product product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store   store           @relation(fields: [storeCode], references: [code])
  user    users           @relation(fields: [userId], references: [userId])

  @@index([productId])
  @@index([variantId])
  @@index([storeCode])
  @@index([userId])
}

model purchase {
  id            Int            @id @default(autoincrement())
  invoiceNumber String?
  invoiceUrl    String?
  supplierId    String?
  supplierName  String?
  totalAmount   Float          @default(0)
  notes         String?
  storeCode     String
  userId        String
  status        PurchaseStatus @default(COMPLETED)
  purchaseDate  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  store store          @relation(fields: [storeCode], references: [code])
  user  users          @relation(fields: [userId], references: [userId])
  items purchaseItem[]

  @@index([storeCode])
  @@index([userId])
}

model purchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  costPrice  Float
  totalPrice Float

  purchase purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Review {
  id         Int      @id @default(autoincrement())
  orderId    Int // Can only review purchased items
  productId  Int
  userId     String
  rating     Int // 1-5
  title      String?
  comment    String?
  images     String[] @default([])
  isVerified Boolean  @default(false) // Verified purchase badge
  status     Status   @default(Published)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order       order         @relation(fields: [orderId], references: [id])
  product     product       @relation(fields: [productId], references: [id])
  user        users         @relation(fields: [userId], references: [userId])
  ReviewReply ReviewReply[]

  @@unique([orderId, productId, userId]) // One review per product per order
  @@index([productId])
  @@index([rating])
}

model ReviewReply {
  id        Int      @id @default(autoincrement())
  reviewId  Int
  userId    String // Staff/Admin replying
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   users  @relation(fields: [userId], references: [userId])
}

/// A reusable lookup group - "Size", "Color", "Weight". `code` is the stable key the
/// rest of the app selects by, so renaming the label never breaks a caller.
model MasterAttribute {
  id           Int           @id @default(autoincrement())
  name         String
  code         String
  description  String?
  /// For measured attributes: "kg", "cm", "ml".
  unit         String?
  storeCode    String
  status       Status        @default(Published)
  displayOrder Int?          @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  store        store         @relation(fields: [storeCode], references: [code])
  entries      MasterEntry[]

  @@unique([code, storeCode])
  @@unique([name, storeCode])
  @@index([storeCode])
}

/// One selectable value inside a MasterAttribute - "L" under Size, "Red" under Color.
model MasterEntry {
  id           Int             @id @default(autoincrement())
  attributeId  Int
  /// Human label shown in a dropdown: "Large".
  name         String
  /// Stored/compared value: "L". Unique within its attribute.
  value        String
  /// Swatch for colour-style attributes.
  colorHex     String?
  metadata     Json?
  storeCode    String
  status       Status          @default(Published)
  displayOrder Int?            @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime?       @updatedAt
  attribute    MasterAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  store        store           @relation(fields: [storeCode], references: [code])

  @@unique([attributeId, value])
  @@index([attributeId])
  @@index([storeCode])
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  storeCode String
  addedAt   DateTime @default(now())

  user    users   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  product product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   store   @relation(fields: [storeCode], references: [code])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model brandName {
  id           Int        @id @default(autoincrement())
  name         String
  storeCode    String
  status       Status     @default(Published)
  displayOrder Int?       @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime?
  store        store      @relation(fields: [storeCode], references: [code])
  product      product[]
  categories   category[] @relation("brandNameTocategory")

  @@unique([name, storeCode])
  @@index([id])
  @@index([storeCode])
}

model attribute {
  id           Int       @id @default(autoincrement())
  name         String
  unit         String?
  storeCode    String
  status       Status    @default(Published)
  displayOrder Int?      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  store        store     @relation(fields: [storeCode], references: [code])
  products     product[]

  @@index([id])
  @@index([storeCode])
}

model supplier {
  id            Int       @id @default(autoincrement())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  storeCode     String
  status        Status    @default(Published)
  displayOrder  Int?      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime?
  store         store     @relation(fields: [storeCode], references: [code])

  @@unique([name, storeCode])
  @@index([id])
  @@index([storeCode])
}

model staff {
  id         Int      @id @default(autoincrement())
  userId     String   @unique
  storeCode  String
  position   String?
  department String?
  hireDate   DateTime @default(now())
  salary     Float?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      store    @relation(fields: [storeCode], references: [code])
  user       users    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@index([storeCode])
  @@index([isActive])
}

model staffAttendance {
  id            Int              @id @default(autoincrement())
  staffId       Int
  date          DateTime         @map("date")
  status        AttendanceStatus @default(PRESENT)
  checkInTime   DateTime?
  checkOutTime  DateTime?
  overtimeHours Float?
  remarks       String?
  recordedBy    Int?
  storeCode     String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  recorder      users?           @relation("staff_attendance_recorder", fields: [recordedBy], references: [id])
  staff         users            @relation("staff_member", fields: [staffId], references: [id], onDelete: Cascade)
  store         store            @relation(fields: [storeCode], references: [code])

  @@unique([staffId, date])
  @@index([staffId])
  @@index([date])
}

model order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  customerId    String
  orderDate     DateTime    @default(now())
  totalAmount   Float       @default(0)
  discount      Float       @default(0)
  tax           Float       @default(0)
  shippingCost  Float       @default(0)
  grandTotal    Float       @default(0)
  status        OrderStatus @default(PENDING)
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  storeCode     String
  customer      users       @relation(fields: [customerId], references: [userId])
  store         store       @relation(fields: [storeCode], references: [code])
  items         orderItem[]
  payments      payment[]
  Review        Review[]

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
}

model orderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  orderNumber String
  productId   Int
  storeCode   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       order    @relation(fields: [orderId], references: [id])
  product     product  @relation(fields: [productId], references: [id])
  store       store    @relation(fields: [storeCode], references: [code])

  @@index([orderId])
  @@index([productId])
  @@index([storeCode])
}

model payment {
  id            Int           @id @default(autoincrement())
  orderId       Int
  amount        Float
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  paymentDate   DateTime      @default(now())
  remarks       String?
  storeCode     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         order         @relation(fields: [orderId], references: [id])
  store         store         @relation(fields: [storeCode], references: [code])

  @@index([orderId])
  @@index([transactionId])
  @@index([paymentDate])
  @@index([storeCode])
}

model staffSalary {
  id               Int           @id @default(autoincrement())
  staffId          Int
  month            Int
  year             Int
  baseSalary       Float
  attendanceBonus  Float?
  deductions       Float?
  advanceDeduction Float?
  netPayable       Float
  paidAmount       Float         @default(0)
  status           PaymentStatus @default(PENDING)
  paymentDate      DateTime?
  remarks          String?
  processedBy      Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  storeCode        String
  processor        users?        @relation("salary_processor", fields: [processedBy], references: [id])
  staff            users         @relation("salary_staff", fields: [staffId], references: [id])
  store            store         @relation(fields: [storeCode], references: [code])

  @@unique([staffId, month, year])
  @@index([staffId])
  @@index([status])
  @@index([month, year])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  ONLINE
}

enum Status {
  Published
  Draft
  Trash
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}
