// Messages from the public contact form. storeCode is optional because the storefront has no
// store context; a null row is site-wide and shows up in every store's admin list.
model ContactMessage {
  id        Int                  @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  storeCode String?
  createdAt DateTime             @default(now())
  updatedAt DateTime?
  store     store?               @relation(fields: [storeCode], references: [code])

  @@index([status])
  @@index([storeCode])
  @@index([createdAt])
}

// Newsletter signups from the storefront. Resubscribing clears unsubscribedAt on the same row,
// so one address is one row forever and the unique key can hold.
model Subscriber {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  storeCode      String?
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
  store          store?    @relation(fields: [storeCode], references: [code])

  @@index([createdAt])
}

enum Status {
  Published
  Draft
  Trash
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

/// One star rating per user per variant. Rating again updates the same row rather than
/// stacking a second vote, and the variant's `rating` / `ratingCount` are recomputed
/// from these rows inside the same transaction so the two can never drift.
model VariantRating {
  id        Int      @id @default(autoincrement())
  userId    String
  variantId Int
  storeCode String
  /// Whole stars, 1-5. Enforced by the API - Postgres has no check constraint here.
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    users          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store   store          @relation(fields: [storeCode], references: [code])

  @@unique([userId, variantId])
  @@index([variantId])
  @@index([storeCode])
}

// Admin-authored storefront pages. The slug is globally unique because the public site
// resolves /<slug> without a store code. passwordHash never leaves the API.
model CmsPage {
  id                 Int        @id @default(autoincrement())
  storeCode          String
  name               String     @db.VarChar(200)
  slug               String     @unique @db.VarChar(200)
  urlOption          String     @default("default")
  status             PageStatus @default(Draft)
  includeHeader      Boolean    @default(true)
  includeFooter      Boolean    @default(true)
  thumbnailUrl       String?
  passwordEnabled    Boolean    @default(false)
  passwordHash       String?
  conditionEnabled   Boolean    @default(false)
  /// 'contact' | 'subscribe' - which public form unlocks the page when conditionEnabled.
  conditionForm      String?
  htmlContent        String     @default("")
  cssContent         String?
  jsContent          String?
  metaTitle          String?    @db.VarChar(255)
  metaDescription    String?
  metaKeywords       String?
  canonicalUrl       String?
  robots             String?
  ogTitle            String?    @db.VarChar(255)
  ogDescription      String?
  ogImageUrl         String?
  /// Array of JSON-LD objects; @graph structures pass through untouched.
  schemaMarkup       Json?
  headerScript       String?
  afterBodyScript    String?
  footerScript       String?
  preloadScript      String?
  hideFromSearch     Boolean    @default(false)
  disableRecaptcha   Boolean    @default(false)
  excludeFromSitemap Boolean    @default(false)
  sitemapPriority    Float      @default(0.5)
  createdById        String?
  updatedById        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime?
  store              store      @relation(fields: [storeCode], references: [code], onDelete: Restrict)

  @@index([storeCode, status])
  @@index([status, hideFromSearch, excludeFromSitemap])
}

enum PageStatus {
  Draft
  Published
  Unpublished
  Archived
}

model Notification {
  id          Int              @id @default(autoincrement())
  storeCode   String
  recipientId String
  type        NotificationType
  title       String           @db.VarChar(200)
  message     String
  link        String?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime         @default(now())
  store       store            @relation(fields: [storeCode], references: [code], onDelete: Cascade)
  recipient   users            @relation(fields: [recipientId], references: [userId], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([storeCode, type, isRead])
}

enum NotificationType {
  USER_REGISTERED
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  LOW_STOCK
}

/// A return/exchange case (RMA): which sold lines are coming back, what happens to the money,
/// and - for an exchange - the replacement order it spawned. Stock moves only when the goods
/// are actually RECEIVED, and only for items still sellable.
model orderReturn {
  id                  Int               @id @default(autoincrement())
  returnNumber        String            @unique
  orderId             Int
  storeCode           String
  customerId          String
  type                ReturnType
  status              ReturnStatus      @default(REQUESTED)
  reason              String
  notes               String?
  refundAmount        Float             @default(0)
  refundMethod        PaymentMethod?
  refundTransactionId String?
  exchangeOrderId     Int?
  requestedById       String
  processedById       String?
  resolvedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  order               order             @relation("OrderReturns", fields: [orderId], references: [id])
  exchangeOrder       order?            @relation("ReturnExchangeOrder", fields: [exchangeOrderId], references: [id])
  store               store             @relation(fields: [storeCode], references: [code])
  customer            users             @relation(fields: [customerId], references: [userId])
  items               orderReturnItem[]

  @@index([storeCode])
  @@index([orderId])
  @@index([status])
  @@index([returnNumber])
}

model orderReturnItem {
  id          Int                 @id @default(autoincrement())
  returnId    Int
  orderItemId Int
  productId   Int
  variantId   Int
  storeCode   String
  quantity    Int
  unitPrice   Float
  amount      Float
  condition   ReturnItemCondition @default(SELLABLE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  return      orderReturn         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   orderItem           @relation(fields: [orderItemId], references: [id])
  product     product             @relation(fields: [productId], references: [id])
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  store       store               @relation(fields: [storeCode], references: [code])

  @@index([returnId])
  @@index([orderItemId])
  @@index([variantId])
  @@index([storeCode])
}

// Site-wide admin settings as key/value rows - logo, site name, chosen invoice layout.
// A missing key means "use the built-in default", so there is no row to seed.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Admin-edited override of a transactional email. `key` matches a file in src/templetes;
// when a row exists its subject/html are sent instead of the file default.
model EmailTemplate {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  subject   String
  html      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum ReturnItemCondition {
  SELLABLE
  DAMAGED
}

enum TaxCategory {
  TAXABLE
  EXEMPT
  ZERO_RATED
  NON_GST
}

enum TaxType {
  WithTax
  WithoutTax
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// What a posting rule needs to know about an account beyond its category: which accounts are
/// real money (CASH, BANK) so the Cash Book can filter to them, which are the AR/AP control
/// accounts that carry party subledgers, and which collect GST either side of a sale.
enum AccountSubType {
  CASH
  BANK
  RECEIVABLE
  PAYABLE
  TAX_INPUT
  TAX_OUTPUT
  INVENTORY
  OTHER
}

enum VoucherType {
  OPENING
  JOURNAL
  SALES
  SALES_RETURN
  PURCHASE
  PURCHASE_RETURN
  RECEIPT
  PAYMENT
  CONTRA
  EXPENSE
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum PartyType {
  CUSTOMER
  SUPPLIER
  STAFF
  OTHER
}

enum PaymentDirection {
  IN
  OUT
}

enum AllocationTargetType {
  ORDER
  PURCHASE
  EXPENSE
}

/// One node of a store's chart of accounts. `systemKey` is how a posting rule finds the account
/// it must debit or credit without hard-coding an id, so a store can rename "Cash in Hand"
/// without breaking sales posting; a null key means the account is user-created and no rule
/// looks for it.
model ledgerAccount {
  id           Int             @id @default(autoincrement())
  storeCode    String
  code         String
  name         String
  category     AccountCategory
  subType      AccountSubType  @default(OTHER)
  parentId     Int?
  description  String?
  isSystem     Boolean         @default(false)
  systemKey    String?
  isActive     Boolean         @default(true)
  status       Status          @default(Published)
  displayOrder Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime?       @updatedAt
  createdById  String?
  updatedById  String?

  store    store           @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  parent   ledgerAccount?  @relation("LedgerAccountHierarchy", fields: [storeCode, parentId], references: [storeCode, id], onDelete: Restrict)
  children ledgerAccount[] @relation("LedgerAccountHierarchy")
  lines    journalLine[]
  payments payment[]
  expenseCategories expense[] @relation("ExpenseCategoryAccount")
  expensesPaidFrom  expense[] @relation("ExpensePaidFromAccount")

  @@unique([storeCode, id])
  @@unique([storeCode, code])
  @@unique([storeCode, systemKey])
  @@index([storeCode, category])
  @@index([storeCode, parentId])
  @@index([storeCode, isActive])
  @@index([storeCode, status])
}

model financialYear {
  id         Int       @id @default(autoincrement())
  storeCode  String
  name       String
  startDate  DateTime
  endDate    DateTime
  isClosed   Boolean   @default(false)
  closedAt   DateTime?
  closedById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  store    store          @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  closedBy users?         @relation("FinancialYearClosedBy", fields: [closedById], references: [userId], onDelete: SetNull)
  entries  journalEntry[]

  @@unique([storeCode, name])
  @@index([storeCode, startDate])
  @@index([storeCode, isClosed])
}

/// A posted voucher. Entries are append-only: a mistake is corrected by posting a reversal that
/// points back at the original through `reversesEntryId`, never by editing or deleting lines.
/// `sourceType`/`sourceId` name the document that produced the entry and are unique together per
/// store, so re-running a posting rule over the same sale cannot double-post it.
model journalEntry {
  id              Int           @id @default(autoincrement())
  storeCode       String
  voucherNumber   String
  voucherType     VoucherType   @default(JOURNAL)
  entryDate       DateTime
  narration       String?
  referenceNumber String?
  sourceType      String?
  sourceId        Int?
  financialYearId Int?
  status          JournalStatus @default(POSTED)
  reversesEntryId Int?          @unique
  reversedAt      DateTime?
  totalDebit      Decimal       @default(0) @db.Decimal(14, 2)
  totalCredit     Decimal       @default(0) @db.Decimal(14, 2)
  isOpening       Boolean       @default(false)
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store           store          @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  financialYear   financialYear? @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  createdBy       users          @relation("JournalEntryCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)
  reversesEntry   journalEntry?  @relation("JournalEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedByEntry journalEntry?  @relation("JournalEntryReversal")
  lines           journalLine[]

  @@unique([storeCode, voucherNumber])
  @@unique([storeCode, sourceType, sourceId])
  @@index([storeCode, entryDate])
  @@index([storeCode, voucherType, entryDate])
  @@index([storeCode, status])
  @@index([storeCode, financialYearId])
}

/// One side of one voucher. A line carries either a debit or a credit, never both. `partyType`
/// and `partyId` are the subledger key: a customer or supplier ledger is derived by filtering
/// the AR/AP control account's lines, which is why there is no ledger account per party.
model journalLine {
  id              Int        @id @default(autoincrement())
  storeCode       String
  journalEntryId  Int
  ledgerAccountId Int
  debit           Decimal    @default(0) @db.Decimal(14, 2)
  credit          Decimal    @default(0) @db.Decimal(14, 2)
  narration       String?
  partyType       PartyType?
  partyId         String?
  lineOrder       Int        @default(0)
  createdAt       DateTime   @default(now())

  entry         journalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  ledgerAccount ledgerAccount @relation(fields: [storeCode, ledgerAccountId], references: [storeCode, id], onDelete: Restrict)
  store         store         @relation(fields: [storeCode], references: [code], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([storeCode, ledgerAccountId])
  @@index([storeCode, partyType, partyId])
}

/// How much of a payment was applied to a particular invoice or bill. A payment with no rows
/// here is an unapplied advance, and the sum of its rows can never exceed `payment.amount`.
model paymentAllocation {
  id          Int                  @id @default(autoincrement())
  storeCode   String
  paymentId   Int
  targetType  AllocationTargetType
  targetId    Int
  amount      Decimal              @db.Decimal(14, 2)
  createdAt   DateTime             @default(now())
  createdById String

  payment   payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  store     store   @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  createdBy users   @relation("PaymentAllocationCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)

  @@unique([paymentId, targetType, targetId])
  @@index([storeCode, targetType, targetId])
  @@index([paymentId])
}

model accountingAuditLog {
  id            Int      @id @default(autoincrement())
  storeCode     String
  action        String
  entityType    String
  entityId      Int?
  summary       String
  detail        Json?
  performedById String
  createdAt     DateTime @default(now())

  store       store @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  performedBy users @relation("AccountingAuditPerformedBy", fields: [performedById], references: [userId], onDelete: Restrict)

  @@index([storeCode, createdAt])
  @@index([storeCode, entityType, entityId])
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A business cost: office rent, electricity, salaries. The expense *category* is a ledger
/// account under EXPENSE rather than a table of its own, so the chart of accounts stays the
/// single source of truth and a new category needs no migration. Money is snapshotted onto the
/// row the same way an estimate snapshots its tax rate, so a later rate change never rewrites a
/// posted expense. A row with `isTemplate` is a recurring definition that is never posted and
/// never appears in reports; the expenses it generates point back at it through `templateId`.
model expense {
  id               Int           @id @default(autoincrement())
  storeCode        String
  expenseNumber    String
  expenseDate      DateTime
  expenseAccountId Int
  /// Where the money left from. Required once the expense is PAID, null while it is a payable.
  paidFromAccountId Int?
  supplierId       Int?
  partyType        PartyType?
  partyId          String?
  referenceNumber  String?
  notes            String?
  status           ExpenseStatus @default(DRAFT)

  amount        Decimal  @default(0) @db.Decimal(14, 2)
  taxId         String?  @db.Uuid
  taxName       String?
  taxRate       Decimal  @default(0) @db.Decimal(5, 2)
  taxType       TaxType?
  taxableAmount Decimal  @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal  @default(0) @db.Decimal(14, 2)
  isInterState  Boolean  @default(false)

  attachments String[]

  isTemplate         Boolean             @default(false)
  templateId         Int?
  recurrenceInterval RecurrenceInterval?
  recurrenceNextDate DateTime?
  recurrenceEndDate  DateTime?

  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdById  String
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  store          store         @relation(fields: [storeCode], references: [code], onDelete: Restrict)
  expenseAccount ledgerAccount @relation("ExpenseCategoryAccount", fields: [storeCode, expenseAccountId], references: [storeCode, id], onDelete: Restrict)
  paidFromAccount ledgerAccount? @relation("ExpensePaidFromAccount", fields: [storeCode, paidFromAccountId], references: [storeCode, id], onDelete: Restrict)
  supplier       supplier?     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  tax            Tax?          @relation(fields: [taxId], references: [id], onDelete: Restrict)
  template       expense?      @relation("ExpenseRecurrence", fields: [templateId], references: [id], onDelete: Restrict)
  generated      expense[]     @relation("ExpenseRecurrence")
  approvedBy     users?        @relation("ExpenseApprovedBy", fields: [approvedById], references: [userId], onDelete: SetNull)
  createdBy      users         @relation("ExpenseCreatedBy", fields: [createdById], references: [userId], onDelete: Restrict)

  @@unique([storeCode, expenseNumber])
  @@index([storeCode, status])
  @@index([storeCode, expenseDate])
  @@index([storeCode, expenseAccountId])
  @@index([storeCode, supplierId])
  @@index([storeCode, isTemplate])
  @@index([storeCode, deletedAt])
}
