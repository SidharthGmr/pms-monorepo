{
  "name": "@pms/api",
  "version": "1.0.0",
  "description": "PMS REST API - Express 5, Prisma, InversifyJS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node index.ts",
    "build": "tsc -p ../../packages/types && prisma generate && tsc",
    "vercel-build": "tsc -p ../../packages/types && prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@pms/types": "*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "inversify": "^7.10.8",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "request-ip": "^3.3.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.7",
    "uuid": "^14.0.0",
    "uuid-random": "^1.3.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.5",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.4",
    "@types/nodemailer": "^8.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
