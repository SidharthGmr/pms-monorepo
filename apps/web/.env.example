# ---------------------------------------------------------------------------
# apps/web environment
# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time - never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- Branding -----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=PMS
NEXT_PUBLIC_APP_DESCRIPTION=Product & Inventory Management System
# Public URL of this site (no trailing slash).
NEXT_PUBLIC_MAIN_DOMAIN_URL=http://localhost:3000
# Optional CDN for static assets (logo, placeholders). Empty = serve from /public.
NEXT_PUBLIC_CDN_BASE_URL=

# --- API ----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Must equal apps/api's CLIENT_ID.
NEXT_PUBLIC_API_CLIENT_ID=change-me
NEXT_PUBLIC_DEFAULT_RECORD_PER_PAGE=25

# --- NextAuth -----------------------------------------------------------------
# Public URL of this site; NextAuth builds callback URLs from it.
NEXTAUTH_URL=http://localhost:3000
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Cloudinary (media library + invoice uploads) -----------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Server-only. Read by the /api/admin-media/* and /api/images/* route handlers.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional integrations ----------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_GTM_ID=
