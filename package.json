{
  "name": "pms",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @pms/web",
    "dev:api": "npm run dev -w @pms/api",
    "build": "npm run build -w @pms/types && npm run build -w @pms/api && npm run build -w @pms/web",
    "build:types": "npm run build -w @pms/types",
    "build:web": "npm run build -w @pms/web",
    "build:api": "npm run build -w @pms/api",
    "typecheck": "npm run typecheck -w @pms/api && npm run typecheck -w @pms/web",
    "lint": "npm run lint -w @pms/web",
    "start:api": "npm run start -w @pms/api",
    "start:web": "npm run start -w @pms/web",
    "migrate:deploy": "npm run migrate:deploy -w @pms/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.7.4",
    "typescript": "5.9.2"
  },
  "overrides": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "engines": {
    "node": ">=18"
  }
}
